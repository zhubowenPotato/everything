<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="LauncherWindow"
        Title="Everything 应用中心"
        Width="1120" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#1B2A22"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#73877A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#356D49"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F2E9"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2EAE4"/>

    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#5C7063"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F0F5F1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E4EEE6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CategoryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#41584A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EFF5F0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8F1EA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardActionButton" TargetType="Button">
      <Setter Property="Background" Value="#356D49"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="#F2F6F2"/>
      <Setter Property="Foreground" Value="#4B6353"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8F1EA"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#DDEBE1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootCard" CornerRadius="18" Background="#F2F6F2" BorderBrush="#DCE6DE" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="42"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar" Grid.Row="0" Background="#FFFFFF" CornerRadius="17,17,0,0" BorderBrush="#E6EDE7" BorderThickness="0,0,0,1">
        <Grid Margin="22,0,12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="BrandLogo" Height="34" Width="102" Stretch="Uniform" HorizontalAlignment="Left"/>
            <Border Background="#EAF3EC" CornerRadius="7" Padding="9,4" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="本地应用中心" FontSize="9" FontWeight="SemiBold" Foreground="#356D49"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="#EFF6F1" CornerRadius="12" Padding="10,5" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="RunningDot" Width="7" Height="7" Fill="#9CAFA2" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="RunningCountText" Text="0 个运行中" FontSize="10.5" Foreground="#4D6557" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE921;" Width="38" Height="30" Margin="0,0,4,0" ToolTip="最小化"/>
            <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" Width="38" Height="30" ToolTip="关闭"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="252"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FAFCFA" CornerRadius="0,0,0,17" BorderBrush="#E8EFE9" BorderThickness="0,0,1,0">
          <Grid Margin="16,18,16,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F0F5F1" CornerRadius="10" BorderBrush="#DEE9E0" BorderThickness="1" Height="38">
              <Grid Margin="10,0">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#7C8F83" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBox x:Name="SearchBox" Margin="24,0,4,0" Background="Transparent" BorderThickness="0" FontSize="12.5" Foreground="#1C2B22" VerticalContentAlignment="Center" Padding="0"/>
                <TextBlock x:Name="SearchPlaceholder" Text="搜索应用或功能" Margin="24,0,0,0" FontSize="12.5" Foreground="#94A69A" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Border>

            <TextBlock Grid.Row="1" Text="分类" Margin="4,18,0,8" FontSize="10" FontWeight="SemiBold" Foreground="#8A9C90"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
              <StackPanel x:Name="CategoryPanel"/>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#F3F7F3" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Everything" FontSize="11" FontWeight="SemiBold" Foreground="#3F5548"/>
                <TextBlock x:Name="FooterHint" Text="选择应用，一键启动本地开发服务器" FontSize="9.5" Foreground="#8A9C90" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,20,26,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="4,0,4,16">
            <StackPanel>
              <TextBlock x:Name="CategoryTitle" Text="全部应用" FontSize="25" FontWeight="SemiBold" Foreground="#18261D"/>
              <TextBlock x:Name="CategorySubtitle" Text="51 个本地应用，选择卡片即可启动" FontSize="11.5" Foreground="#7B8D81" Margin="1,5,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E7F2EA" CornerRadius="12" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#356D49" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ResultCountText" Text="51 个应用" FontSize="10.5" Foreground="#356D49"/>
              </StackPanel>
            </Border>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <WrapPanel x:Name="AppsPanel" Orientation="Horizontal"/>
          </ScrollViewer>
          <TextBlock x:Name="EmptyState" Grid.Row="1" Text="没有找到匹配的应用" FontSize="13" Foreground="#91A397" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="0,0,17,17" BorderBrush="#E6EDE7" BorderThickness="0,1,0,0">
        <Grid Margin="22,0,16,0" Height="41">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#7FA18A" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="就绪 · 点击卡片启动应用" FontSize="10.5" Foreground="#607467"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="LogsButton" Content="日志目录" Style="{StaticResource GhostButton}" Height="26" Margin="0,0,8,0"/>
            <Button x:Name="StopAllButton" Content="停止全部" Style="{StaticResource GhostButton}" Height="26" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
